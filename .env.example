# Copy to .env.local for development. Production values live in the managed secret store, never in git.

# App role: dropdesk_app (non-owner, no BYPASSRLS). The web/api process must never use the owner URL.
DATABASE_URL=postgres://dropdesk_app:CHANGE_ME@localhost:5432/dropdesk

# Owner role: migrations only (CI job / release step). Not mounted into the web container.
DATABASE_OWNER_URL=postgres://dd_owner:CHANGE_ME@localhost:5432/dropdesk

# Comma-separated origins allowed to make state-changing requests (CSRF check). https:// enables Secure cookies.
APP_ORIGIN=http://localhost:3000

# Feature flags (S7). Off by default; NIPOST stays off until written authorisation (Blueprint §10).
FEATURE_NDAPS_LIVE=false
